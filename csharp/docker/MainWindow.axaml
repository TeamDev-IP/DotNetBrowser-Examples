<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:browser="clr-namespace:DotNetBrowser.AvaloniaUi;assembly=DotNetBrowser.AvaloniaUi"
        x:Class="Example.Docker.MainWindow"
        Width="800"
        Height="500"
        Title="DotNetBrowser Docker Demo"
        Closed="Window_Closed"
        mc:Ignorable="d">
  <Grid>
    <browser:BrowserView x:Name="BrowserView" />
  </Grid>
</Window>
