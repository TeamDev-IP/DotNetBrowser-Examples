{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ReportService": {
    "UserDataDirectory": "Data\\UserData",
    "ChromiumDirectory": "Data\\Chromium",
    "OutputDirectory": "Data\\Output",
    "IntervalSeconds": 60,
    "CaptureDelayMs": 500,
    "Jobs": [
      {
        "Name": "report",
        "Url": "report.html",
        "ReadyScript": "document.documentElement.dataset.ready === 'true'",
        "Selector": "#summary",
        "Pdf": true,
        "Png": true,
        "Json": true
      },
      {
        "Name": "example",
        "Url": "https://example.com/",
        "ReadyScript": "document.readyState === 'complete'",
        "Selector": "p",
        "Pdf": true,
        "Png": true,
        "Json": true
      }
    ]
  }
}
