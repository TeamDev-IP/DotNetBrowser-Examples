<Window x:Class="ScreenSharing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:DotNetBrowser.Wpf;assembly=DotNetBrowser.Wpf"
        Title="Screen sharing — DotNetBrowser" Height="600" Width="800"
        Closed="Window_Closed">
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="8">
            <Button Name="stopButton" DockPanel.Dock="Right" Content="Stop sharing"
                    Width="120" IsEnabled="False" Click="StopButton_Click" />
            <TextBlock Name="statusText" VerticalAlignment="Center"
                       Text="Click Share screen in the page." />
        </DockPanel>
        <wpf:BrowserView Name="browserView" />
    </DockPanel>
</Window>
