<Window x:Class="ScreenSharing.SourcePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose what to share" Height="480" Width="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="The page wants to share the contents of your screen." />
        <StackPanel DockPanel.Dock="Bottom">
            <CheckBox Name="audioBox" Margin="0,8,0,0" Content="Share audio" />
            <CheckBox Name="notificationBox" Margin="0,4,0,0" IsChecked="True"
                      Content="Show the sharing notification" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="Cancel" Width="80" Margin="4,0" IsCancel="True" />
                <Button Name="shareButton" Content="Share" Width="80" Margin="4,0"
                        IsDefault="True" IsEnabled="False" Click="Share_Click" />
            </StackPanel>
        </StackPanel>
        <ListBox Name="sourceList" SelectionChanged="SourceList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Image Source="{Binding Thumbnail}" Width="100" Height="60"
                               Stretch="Uniform" StretchDirection="DownOnly" />
                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" Width="260"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
