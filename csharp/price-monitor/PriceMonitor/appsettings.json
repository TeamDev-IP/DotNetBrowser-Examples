{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "PriceMonitor.DiscordNotifier": "Information"
      }
    }
  },
  "Discord": {
    "WebhookUrl": ""
  },
  "Monitor": {
    "DataDirectory": "Data",
    "IntervalSeconds": 60,
    "PageDelaySeconds": 5,
    "PageTimeoutSeconds": 30,
    "Attempts": 3,
    "MockShop": {
      "Enabled": true,
      "ChangeEverySeconds": 90
    },
    "Products": [
      {
        "Name": "Stride Runner \"Volt\"",
        "Url": "https://shop.example/products/stride-runner-volt",
        "Source": "Dom",
        "PriceSelector": "#price",
        "CartButtonSelector": "#add-to-cart"
      },
      {
        "Name": "Court Classic Low",
        "Url": "https://shop.example/products/court-classic-low",
        "Source": "Json",
        "ApiUrl": "https://shop.example/api/products/court-classic-low"
      }
    ]
  }
}
